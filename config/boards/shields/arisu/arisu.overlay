#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };


    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <15>;
        rows = <5>;
        // Ánh xạ dựa trên layout QMK bạn cung cấp
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(1,14)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)          RC(2,14)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)                   RC(3,14)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)                   RC(3,13)
RC(4,0)         RC(4,2)         RC(4,4) RC(4,5)         RC(4,8)          RC(4,10)                            RC(4,12) RC(4,13) RC(4,14)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row"; // Hướng Diode: Cột sang Hàng

        /* 5 Rows - Sử dụng các chân từ GP2 đến GP6 (Pro Micro 0 đến 4) */
        row-gpios
            = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 0
            , <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 1
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 2
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 3
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 4
            ;

        /* 15 Columns - Sử dụng các chân còn lại trên headers và 2 chân mở rộng (P1.01, P1.02) */
        col-gpios
            = <&pro_micro 5  GPIO_ACTIVE_HIGH> // Col 0
            , <&pro_micro 6  GPIO_ACTIVE_HIGH> // Col 1
            , <&pro_micro 7  GPIO_ACTIVE_HIGH> // Col 2
            , <&pro_micro 8  GPIO_ACTIVE_HIGH> // Col 3
            , <&pro_micro 9  GPIO_ACTIVE_HIGH> // Col 4
            , <&pro_micro 10 GPIO_ACTIVE_HIGH> // Col 5
            , <&pro_micro 16 GPIO_ACTIVE_HIGH> // Col 6
            , <&pro_micro 14 GPIO_ACTIVE_HIGH> // Col 7
            , <&pro_micro 15 GPIO_ACTIVE_HIGH> // Col 8
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> // Col 9
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> // Col 10
            , <&pro_micro 20 GPIO_ACTIVE_HIGH> // Col 11
            , <&pro_micro 21 GPIO_ACTIVE_HIGH> // Col 12
            , <&gpio1 1      GPIO_ACTIVE_HIGH> // Col 13 (Chân P1.01 - Pad mặt dưới)
            , <&gpio1 2      GPIO_ACTIVE_HIGH> // Col 14 (Chân P1.02 - Pad mặt dưới)
            ;
    };
};